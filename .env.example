# Cloud sync (optional) — Supabase project credentials.
# Copy this file to ".env" and fill in your values, or set them as environment
# variables in Vercel (Project → Settings → Environment Variables).
#
# Find these in your Supabase project: Settings → API.
# The anon key is safe to expose in a frontend — Row Level Security protects data.
#
# Leave these unset to run the app in local-only mode (no sign in, no sync).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
